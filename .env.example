# Frontend Environment Variables
# Copy this file to .env.local for local development

# API Base URL (leave empty for development with Vite proxy)
# Set this in production to your backend URL (e.g., https://api.yourdomain.com)
#
# Vercel/Netlify: Set VITE_API_BASE_URL in dashboard → Settings → Environment Variables
# Example: https://leadsbd-api.fly.dev (no trailing slash)
VITE_API_BASE_URL=

# WhatsApp Business Number (international format, no + prefix)
VITE_WHATSAPP_NUMBER=8801733000786
