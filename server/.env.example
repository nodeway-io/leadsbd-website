# Server Configuration
PORT=3001

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here

# Contact Email (receives audit requests)
CONTACT_TO_EMAIL=jakir@leads.bd

# Allowed origins for CORS (comma-separated for multiple origins)
# Examples:
#   Single: https://yourdomain.com
#   Multiple: https://leads.bd,https://www.leads.bd,https://preview-123.vercel.app
# For development: leave unset or use http://localhost:5173
SITE_URLS=http://localhost:5173

# Rate limiting configuration
# Maximum requests per IP within the time window
RATE_LIMIT_MAX=5
# Time window in milliseconds (default: 15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
